{
  "name": "@kuraykaraaslan/kui-gantt",
  "version": "0.0.1",
  "description": "Standalone Gantt chart — vanilla TS core + optional React subpath. WBS tree, drag/resize, dependency arrows, critical path, baseline ghosts, export.",
  "keywords": ["gantt", "react", "typescript", "scheduler", "project-management", "kui"],
  "license": "Apache-2.0",
  "author": "Kuray Karaaslan <kuraykaraaslan@gmail.com>",
  "homepage": "https://github.com/kuraykaraaslan/kui-gantt#readme",
  "bugs": { "url": "https://github.com/kuraykaraaslan/kui-gantt/issues" },
  "repository": { "type": "git", "url": "git+https://github.com/kuraykaraaslan/kui-gantt.git" },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/modules/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/modules/index.d.ts",
      "import": "./dist/index.js"
    },
    "./react": {
      "types": "./dist/react/index.d.ts",
      "import": "./dist/react/index.js"
    },
    "./styles.css": "./dist/styles.css"
  },
  "files": ["dist", "README.md", "LICENSE"],
  "sideEffects": ["**/*.css"],
  "peerDependencies": {
    "react": "^18 || ^19",
    "react-dom": "^18 || ^19",
    "zustand": "^5.0.0"
  },
  "peerDependenciesMeta": {
    "react": { "optional": true },
    "react-dom": { "optional": true }
  },
  "dependencies": {
    "@fortawesome/fontawesome-svg-core": "^7.2.0",
    "@fortawesome/free-solid-svg-icons": "^7.2.0",
    "@fortawesome/react-fontawesome": "^3.3.1",
    "clsx": "^2.0.0",
    "tailwind-merge": "^3.0.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.0.0",
    "postcss": "^8.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.0.0",
    "vite": "^6.0.0",
    "zustand": "^5.0.0"
  },
  "scripts": {
    "dev": "vite --config vite.config.demo.ts",
    "build:js": "vite build && vite build --config vite.config.react.ts",
    "build:types": "tsc -p tsconfig.lib.json",
    "build:css": "node scripts/build-css.mjs",
    "build": "pnpm build:js && pnpm build:types && pnpm build:css",
    "prepublishOnly": "pnpm build"
  }
}
